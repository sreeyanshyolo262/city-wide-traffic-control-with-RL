<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO Edge definitions - 2 lanes per direction -->
<edges>
    <!-- Northbound (from south to center, from center to north) -->
    <edge id="south_to_center" from="south" to="center" numLanes="3" speed="13.89"/>
    <edge id="center_to_north" from="center" to="north" numLanes="3" speed="13.89"/>
    
    <!-- Southbound (from north to center, from center to south) -->
    <edge id="north_to_center" from="north" to="center" numLanes="3" speed="13.89"/>
    <edge id="center_to_south" from="center" to="south" numLanes="3" speed="13.89"/>
    
    <!-- Eastbound (from west to center, from center to east) -->
    <edge id="west_to_center" from="west" to="center" numLanes="3" speed="13.89"/>
    <edge id="center_to_east" from="center" to="east" numLanes="3" speed="13.89"/>
    
    <!-- Westbound (from east to center, from center to west) -->
    <edge id="east_to_center" from="east" to="center" numLanes="3" speed="13.89"/>
    <edge id="center_to_west" from="center" to="west" numLanes="3" speed="13.89"/>
</edges>
