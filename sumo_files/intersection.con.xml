<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO Connection definitions - enables all turning movements -->
<connections>
    <!-- From South (Northbound) - Lane 0: left, Lane 1: straight, Lane 2: right -->
    <connection from="south_to_center" to="center_to_west" fromLane="0" toLane="0"/>
    <connection from="south_to_center" to="center_to_north" fromLane="1" toLane="1"/>
    <connection from="south_to_center" to="center_to_east" fromLane="2" toLane="2"/>
    
    <!-- From North (Southbound) - Lane 0: left, Lane 1: straight, Lane 2: right -->
    <connection from="north_to_center" to="center_to_east" fromLane="0" toLane="0"/>
    <connection from="north_to_center" to="center_to_south" fromLane="1" toLane="1"/>
    <connection from="north_to_center" to="center_to_west" fromLane="2" toLane="2"/>
    
    <!-- From West (Eastbound) - Lane 0: left, Lane 1: straight, Lane 2: right -->
    <connection from="west_to_center" to="center_to_south" fromLane="0" toLane="0"/>
    <connection from="west_to_center" to="center_to_east" fromLane="1" toLane="1"/>
    <connection from="west_to_center" to="center_to_north" fromLane="2" toLane="2"/>
    
    <!-- From East (Westbound) - Lane 0: left, Lane 1: straight, Lane 2: right -->
    <connection from="east_to_center" to="center_to_north" fromLane="0" toLane="0"/>
    <connection from="east_to_center" to="center_to_west" fromLane="1" toLane="1"/>
    <connection from="east_to_center" to="center_to_south" fromLane="2" toLane="2"/>
</connections>
